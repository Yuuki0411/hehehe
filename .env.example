# =====================================================================
# Topup Digems — contoh konfigurasi server
# ---------------------------------------------------------------------
# Cara pakai:
#   1. Salin file ini menjadi `.env`  (cp .env.example .env)
#   2. Isi nilainya lalu jalankan server seperti biasa:
#        node server/server.js
#   3. Server MEMBACA `.env` otomatis saat start (tanpa dependency).
#      `.env` TIDAK boleh di-commit ke git (sudah ada di .gitignore).
# =====================================================================

PORT=3000

# Password halaman admin (terserah_admin.html)
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------
# Sinkronisasi otomatis ke aplikasi "Catatan Keuangan" (folder Keuangan/)
# ---------------------------------------------------------------------
# Setiap transaksi yang berstatus SUKSES (konfirmasi admin / auto-polling
# supplier) otomatis dicatat sebagai PEMASUKAN di aplikasi Keuangan.
# Cara ambil nilainya:
#   1. KEUANGAN_SUPABASE_URL & KEUANGAN_SUPABASE_SERVICE_KEY
#      Dashboard Supabase -> Settings -> API -> Project URL & service_role
#      secret (bukan anon key!). Service key RAHASIA — jangan disebar.
#   2. KEUANGAN_OWNER_USER_ID
#      Dashboard Supabase -> Authentication -> Users -> klik email akun
#      Keuangan kamu -> salin UUID di kolom "User ID".
KEUANGAN_SUPABASE_URL=https://xxxx.supabase.co
KEUANGAN_SUPABASE_SERVICE_KEY=eyJ...
KEUANGAN_OWNER_USER_ID=

# Opsional (punya nilai default bila dikosongkan):
# Nama kategori pemasukan yang dipakai (dibuat otomatis bila belum ada)
#KEUANGAN_CATEGORY_NAME=Topup Game (Digems)
# Nama dompet bila akun Keuangan belum punya dompet sama sekali
#KEUANGAN_WALLET_NAME=Kas

# ---------------------------------------------------------------------
# Integrasi supplier Digiflazz (opsional — topup otomatis via server)
# ---------------------------------------------------------------------
#SUPPLIER_ENABLED=1
#SUPPLIER_USERNAME=
#SUPPLIER_APIKEY=
#SUPPLIER_BASE_URL=https://api.digiflazz.com/v1
#SUPPLIER_TESTING=1
#SUPPLIER_POLL_MS=30000

# ---------------------------------------------------------------------
# Email verifikasi & OTP (opsional — tanpa ini, kode dicetak di console)
# ---------------------------------------------------------------------
#MAIL_USER=
#MAIL_PASS=
#MAIL_FROM=
